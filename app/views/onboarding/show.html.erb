<main class="shell">
  <%= render "shared/navigation" %>

  <section class="page-heading">
    <div>
      <p class="eyebrow">Welcome</p>
      <h1>Get set up in a few steps.</h1>
      <p>PerformanceOS turns your daily inputs into one auditable plan. Here's the quickest path to your first one.</p>
    </div>
  </section>

  <section class="panel">
    <ol class="onboarding">
      <% @progress.steps.each_with_index do |step, index| %>
        <li class="onboarding-step <%= "onboarding-step--done" if step.done? %>">
          <span class="onboarding-step__mark"><%= step.done? ? "✓" : (step.optional? ? "★" : index + 1) %></span>
          <div>
            <strong>
              <%= step.title %><% if step.optional? %> <small>(optional)</small><% end %>
            </strong>
            <p><%= step.prompt %> <%= link_to step.cta, step.path, class: "text-link" %></p>

            <% if step.key == :target && !step.done? && @progress.steps.first.done? %>
              <p>Or generate a balanced program from your goal — log weights as you go, and edit anything.</p>
              <%= button_to "Generate my program", program_path, class: "button" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>

    <% if @progress.complete? %>
      <%= link_to "You're set — go to today's plan", root_path, class: "button" %>
    <% else %>
      <%= link_to "Skip for now", root_path, class: "text-link" %>
      <p class="evidence-note">
        Nothing is lost by skipping. Today's plan keeps a short version of this list until setup is done.
      </p>
    <% end %>
  </section>
</main>
