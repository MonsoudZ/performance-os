<%# Thirteen flat links wrapped onto three rows at 1400px and four below 1180px,
    and every page added one more. The phone already had the answer — four
    destinations and a sheet for the rest — so the topbar groups the same way.
    Each menu knows whether the page you are on lives inside it. %>
<header class="topbar">
  <a class="brand" href="/">
    <span class="brand__mark">P</span>
    <span>PerformanceOS</span>
  </a>

  <% if authenticated? %>
    <nav class="nav-links" aria-label="Primary" data-controller="menu">
      <%= link_to "Today", root_path,
        class: class_names("nav-links__link", "is-current" => current_page?(root_path)) %>

      <%= render "shared/nav_menu", label: "Training", links: {
        "Workouts" => workout_templates_path,
        "Training targets" => exercise_prescriptions_path,
        "Exercises" => exercises_path,
        "History" => workout_sessions_path,
        "Blocks" => mesocycles_path,
        "Conditioning" => conditioning_sessions_path
      } %>

      <%= render "shared/nav_menu", label: "Nutrition", links: {
        "Food log" => nutrition_path,
        "Meals" => meals_path
      } %>

      <%= render "shared/nav_menu", label: "Review", links: {
        "Progress" => progress_path,
        "Weekly review" => weekly_review_path
      } %>

      <%= link_to "Log workout", new_workout_session_path, class: "nav-links__primary" %>

      <%= render "shared/nav_menu", label: "Account", align: "end", links: {
        "Goal" => goal_periods_path,
        "Profile" => edit_profile_path
      } do %>
        <%= button_to "Sign out", session_path, method: :delete, class: "nav-menu__signout" %>
      <% end %>
    </nav>
  <% end %>
</header>
