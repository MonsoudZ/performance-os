<main class="shell">
  <%= turbo_stream_from Current.user %>
  <%= render "shared/navigation" %>

  <section class="page-heading">
    <div>
      <p class="eyebrow">Nutrition evidence</p>
      <h1>Fuel the objective.</h1>
      <p>Food logs snapshot their macros. Weight trends stay historically stable. Targets come from the active goal or enough evidence—not guesswork.</p>
    </div>
  </section>

  <%= render "log_workspace" %>

  <section class="nutrition-workspace nutrition-workspace--support">
    <article class="panel">
      <div class="panel__header">
        <div>
          <p class="eyebrow">Body weight</p>
          <h2>Update the trend.</h2>
        </div>
      </div>

      <%= form_with model: @body_metric, id: "body_metric_form", class: "stacked-form",
        data: { controller: "unsaved-input" } do |form| %>
        <div class="form-grid">
          <label><span>Weight (<%= weight_unit %>)</span><%= form.number_field :weight_kg, value: weight_field_value(form.object.weight_kg), min: 0, step: measurement_step, required: true %></label>
          <label><span>Measured on</span><%= form.date_field :measured_on, required: true %></label>
        </div>
        <%= form.submit "Log weight", class: "button" %>
      <% end %>

      <% if @weight_trends.any? %>
        <div class="trend-strip">
          <% @weight_trends.reverse_each do |trend| %>
            <div>
              <span><%= trend.trend_date.strftime("%b %-d") %></span>
              <strong><%= weight_amount trend.ewma_kg, precision: 2 %></strong>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @recent_body_metrics.any? %>
        <div class="compact-list">
          <% @recent_body_metrics.each do |metric| %>
            <div class="compact-list__item">
              <strong>
                <%= weight(metric.weight_kg) %>
                <% if metric.source == "healthkit" %><span class="pill">Synced</span><% end %>
              </strong>
              <span><%= metric.measured_on.strftime("%b %-d, %Y") %></span>
              <small>
                <%= button_to "Remove", body_metric_path(metric), method: :delete,
                  form: { data: { turbo_confirm: "Remove this weigh-in?" } },
                  class: "text-button text-button--danger" %>
              </small>
            </div>
          <% end %>
        </div>
      <% end %>

      <p class="evidence-note">
        <% if @expenditure %>
          Adaptive expenditure: <strong><%= @expenditure.estimated_tdee.round %> kcal</strong> · <%= @expenditure.confidence %> confidence
          <%= expenditure_basis_note(@expenditure) %>
        <% else %>
          Adaptive expenditure unlocks after 7 logged intake days and at least 7 days of weight-trend evidence.
        <% end %>
      </p>

      <% if @activity.any? %>
        <p class="evidence-note">
          Your watch reported
          <% if @activity.steps %><strong><%= number_with_delimiter @activity.steps %></strong> steps<% end %>
          <% if @activity.steps && @activity.total_energy_kcal %> and <% end %>
          <% if @activity.total_energy_kcal %>
            <strong><%= number_with_delimiter @activity.total_energy_kcal %> kcal</strong> burned
            (<%= number_with_delimiter @activity.active_energy_kcal %> active,
            <%= number_with_delimiter @activity.basal_energy_kcal %> resting)
          <% end %>
          today. Today is still being lived, so it counts towards expenditure tomorrow.
        </p>
      <% end %>
    </article>

    <article class="panel">
      <div class="panel__header">
        <div>
          <p class="eyebrow">Food catalog</p>
          <h2>Add a staple.</h2>
        </div>
      </div>

      <%= form_with url: search_foods_path, method: :get, class: "food-search" do %>
        <%= search_field_tag :q, nil, placeholder: "Search the food database…", aria: { label: "Search the food database" } %>
        <%= submit_tag "Search", class: "button button--secondary", name: nil %>
      <% end %>

      <%# Seven fields, open, on the page somebody comes to in order to log —
          they took as much room as the food log itself and pushed what the user
          already has below the fold. Searching finds most foods, so typing one
          out is the fallback and sits folded until it is wanted.
          A <details> rather than Stimulus: nothing else has to know it is open,
          and it works before any JavaScript runs. %>
      <details class="disclosure">
        <summary>Add a food manually</summary>
        <div class="disclosure__body">
          <%= render "foods/form", food: @food, submit_label: "Add food" %>
        </div>
      </details>

      <% if @custom_foods.any? %>
        <div class="compact-list">
          <% @custom_foods.each do |food| %>
            <div class="compact-list__item">
              <strong><%= food.display_name %></strong>
              <span><%= food.kcal.round %> kcal · <%= food.protein_g.round %> g protein / <%= number_with_precision food.serving_grams, precision: 1, strip_insignificant_zeros: true %> g</span>
              <small>
                <%= link_to "Edit", edit_food_path(food), class: "text-link" %>
                <%= button_to "Delete", food_path(food), method: :delete,
                  form: { data: { turbo_confirm: "Remove #{food.display_name} from your catalog?" } },
                  class: "text-button text-button--danger" %>
              </small>
            </div>
          <% end %>
        </div>
      <% end %>
    </article>
  </section>
</main>
