<% content_for :title, "Profile · PerformanceOS" %>

<main class="shell">
  <%= render "shared/navigation" %>

  <section class="page-heading">
    <div>
      <p class="eyebrow">Profile</p>
      <h1>Your training profile.</h1>
      <p>These drive what the program generator builds and how the plan scales. Change them anytime — regenerate to pick up new equipment or goals.</p>
    </div>
  </section>

  <section class="panel">
    <%= form_with model: @user, url: profile_path, method: :patch, class: "stacked-form" do |form| %>
      <h2>Training</h2>

      <label>
        <span>Experience</span>
        <%= form.select :experience_level, User::EXPERIENCE_LEVELS.map { |level| [ level.humanize, level ] } %>
      </label>

      <label>
        <span>Training days per week</span>
        <%= form.number_field :training_days_per_week, min: 1, max: 7, step: 1 %>
      </label>

      <fieldset class="checkbox-group">
        <legend>Available equipment</legend>
        <p class="checkbox-group__hint">The generator only picks lifts you can do with these.</p>
        <%= form.collection_check_boxes :available_equipment, User::EQUIPMENT_OPTIONS, :to_s, :humanize do |b| %>
          <label class="checkbox-option"><%= b.check_box %><span><%= b.text %></span></label>
        <% end %>
      </fieldset>

      <h2>About you</h2>

      <label>
        <span>Sex</span>
        <%= form.select :sex, %w[male female unspecified].map { |s| [ s.humanize, s ] }, include_blank: "Prefer not to say" %>
      </label>

      <label>
        <span>Date of birth</span>
        <%= form.date_field :birth_date %>
      </label>

      <label>
        <span>Height (<%= length_unit %>)</span>
        <%= form.number_field :height_cm, value: length_field_value(form.object.height_cm), step: measurement_step, min: 0 %>
      </label>

      <label>
        <span>Max heart rate (bpm)</span>
        <%= form.number_field :max_hr, min: 1, step: 1 %>
      </label>

      <h2>Preferences</h2>

      <label>
        <span>Units</span>
        <%= form.select :unit_system, [ [ "Metric (kg)", "metric" ], [ "Imperial (lb)", "imperial" ] ] %>
      </label>

      <label>
        <span>Time zone</span>
        <%= form.time_zone_select :time_zone %>
      </label>

      <%= form.submit "Save profile", class: "button" %>
    <% end %>
  </section>

  <section class="panel">
    <div class="panel__header">
      <div>
        <p class="eyebrow">Your data</p>
        <h2>Take a copy.</h2>
      </div>
      <%= link_to "Export everything", account_export_path, class: "button button--inline button--secondary" %>
    </div>

    <p class="evidence-note">
      One JSON file holding everything this account has: every workout and set, every weigh-in, food
      entry and conditioning session, every coaching decision and the evidence it cites, and your
      profile. Weights are in kilograms and distances in metres — the units the app stores, whichever
      it shows you — so the numbers are the ones that were recorded rather than a rounded rendering.
      Passwords and device tokens are not included.
    </p>
  </section>

  <section class="panel panel--danger">
    <div class="panel__header">
      <div>
        <p class="eyebrow">Danger zone</p>
        <h2>Delete your account.</h2>
      </div>
    </div>

    <p class="evidence-note">
      This erases everything: every workout and set you have logged, every weigh-in and food entry,
      every coaching decision and the evidence behind it, and any paired device. It cannot be undone,
      so <%= link_to "take a copy first", account_export_path, class: "text-link" %> if you want one.
    </p>

    <%= form_with url: profile_path, method: :delete, class: "stacked-form",
      data: { turbo_confirm: "Delete your account and everything in it? This cannot be undone." } do |form| %>
      <label>
        <span>Confirm your password</span>
        <%= password_field_tag :password, nil, required: true, autocomplete: "current-password" %>
      </label>
      <%= form.submit "Delete my account", class: "button button--danger" %>
    <% end %>
  </section>
</main>
