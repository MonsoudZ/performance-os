<main class="shell">
  <%= turbo_stream_from Current.user %>
  <%= render "shared/navigation" %>

  <section class="page-heading">
    <div>
      <p class="eyebrow">Session complete</p>
      <h1><%= @workout_session.template_name || @workout_session.performed_at.strftime("%B %-d training") %></h1>
      <p><%= pluralize @workout_session.set_entries.size, "logged set" %></p>
    </div>
    <div class="page-heading__actions">
      <%= link_to "Edit", edit_workout_session_path(@workout_session), class: "button button--inline" %>
      <%= button_to "Delete", workout_session_path(@workout_session), method: :delete,
        form: { data: { turbo_confirm: "Delete this workout and its logged sets?" } },
        class: "text-button text-button--danger" %>
      <%= link_to "Log another", new_workout_session_path, class: "button button--inline" %>
    </div>
  </section>

  <% if @workout_session.template_snapshot.present? %>
    <section class="workout-completion">
      <article class="panel">
        <p class="eyebrow">Workout completion</p>
        <strong><%= @workout_session.completion_percentage %>%</strong>
        <span><%= @workout_session.completed_working_sets %> of <%= @workout_session.planned_working_sets %> planned working sets</span>
      </article>
      <article class="panel">
        <p class="eyebrow">Session volume</p>
        <strong><%= weight(@set_entries.reject(&:is_warmup?).sum { |set| set.weight_kg.to_f * set.reps.to_i }, precision: 0) %></strong>
        <span>Working-set load × reps</span>
      </article>
    </section>
  <% end %>

  <section class="decision-grid">
    <% if @decisions.empty? %>
      <article class="panel decision-card" aria-busy="true">
        <p class="eyebrow">Progression</p>
        <h2>Evaluating progression…</h2>
        <p>Your sets are saved. This updates automatically the moment the engine finishes.</p>
      </article>
    <% end %>
    <% @decisions.each do |decision| %>
      <article class="panel decision-card decision-card--<%= decision.output["status"] %>">
        <p class="eyebrow"><%= decision.inputs["exercise_name"] %></p>
        <h2><%= progression_headline(decision.output) %></h2>
        <p><%= decision.output["guidance"] %></p>
        <% if decision.output["next_weight_kg"] %>
          <strong class="next-load"><%= weight(decision.output["next_weight_kg"]) %></strong>
        <% end %>
        <span class="confidence"><%= decision.confidence %> confidence · <%= decision.rule_key %></span>
      </article>
    <% end %>
  </section>

  <% if @withdrawn_decisions.any? %>
    <section class="panel">
      <div class="panel__header">
        <div>
          <p class="eyebrow">Withdrawn</p>
          <h2>Recommendations this session no longer makes</h2>
        </div>
      </div>

      <div class="decision-trail">
        <% @withdrawn_decisions.each do |decision| %>
          <%= render "coaching_decisions/progression", decision: decision, show_exercise: true %>
        <% end %>
      </div>

      <p class="evidence-note">
        Correcting or deleting a workout withdraws what it previously recommended. The withdrawn
        version stays here so a recommendation you already acted on never disappears from the record.
      </p>
    </section>
  <% end %>

  <section class="panel">
    <div class="panel__header">
      <div>
        <p class="eyebrow">Audit trail</p>
        <h2>Logged sets</h2>
      </div>
    </div>
    <div class="logged-sets">
      <% @set_entries.each do |set| %>
        <div>
          <span>#<%= set.set_index %></span>
          <strong><%= set.exercise.name %></strong>
          <span><%= weight(set.weight_kg) %> × <%= set.reps %></span>
          <span><%= set.rir %> RIR</span>
        </div>
      <% end %>
    </div>
  </section>
</main>
